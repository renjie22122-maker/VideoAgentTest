# Copy to .env. Demo mode requires no keys. Restart the local server after edits.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional preset: custom, deepseek, minimax, openai, anthropic, gemini, openrouter, qwen, ollama.
# Existing BASE_URL / MODEL / API_KEY configurations remain supported.
LLM_PROVIDER=
# openai (Chat Completions), anthropic (Messages), gemini (generateContent).
LLM_PROTOCOL=
# Optional output limit in tokens; empty uses vendor default (Anthropic: 16384).
LLM_MAX_TOKENS=
# auto selects protocol JSON options; prompt omits optional JSON parameters.
LLM_JSON_MODE=auto
# Only needed by Anthropic keys spanning multiple workspaces.
LLM_WORKSPACE_ID=
# OpenAI-compatible Chat Completions, e.g. https://api.deepseek.com
# Model names are deliberately not hardcoded. Use your provider's available model ID.

# A YOUR-OWN adapter implementing docs/media-gateway.md; NOT a vendor URL directly.
MEDIA_GATEWAY_URL=
MEDIA_API_KEY=
IMAGE_MODEL=
# Optional direct OpenAI text-to-image. Keep gateway to preserve existing setup.
IMAGE_PROVIDER=gateway
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_API_KEY=
VIDEO_MODEL=
# Empty preserves auto-detection. Options: gateway, minimax, fal-kling.
# fal-kling uses FAL_API_KEY and a fixed Kling 3.0 Pro endpoint.
VIDEO_PROVIDER=
# Optional Kling native audio: true / false / empty (provider default).
VIDEO_GENERATE_AUDIO=
QA_GATEWAY_URL=
QA_API_KEY=
# Optional: gateway /review extracts frames and performs multimodal review.
# Without it all actual visual quality decisions remain human review.

# Optional local storage directory; defaults to .studio in this project.
STUDIO_DATA_DIR=.studio

# fal.ai asset library and storyboard composition (independent secret)
# Set IMAGE_PROVIDER=fal to use FLUX/Seedream for storyboard images.
FAL_API_KEY=
